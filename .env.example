# ─────────────────────────────────────────────────────────────────────────────
#  InnoLearn — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Free cluster at https://cloud.mongodb.com (M0 tier, no credit card)
# Get the string from: Atlas → Cluster → Connect → Drivers → Node.js 4.x+
# Replace <password> with your DB user's password; do NOT include < >
MONGODB_URI=mongodb+srv://innolearn_admin:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=innolearn

# ── JWT ──────────────────────────────────────────────────────────────────────
# Long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Render can also auto-generate this (generateValue: true in render.yaml)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── Platform Admin ────────────────────────────────────────────────────────────
# The server checks these three at startup (see server/routes/platform.js).
# Until a named operator exists in the `platform_operators` collection, this
# legacy credential is the only way into /platform. Create the first operator
# with: node scripts/create-platform-operator.js --email you@example.com --tier owner
# (Once one exists, this credential stops being accepted.)
PLATFORM_ADMIN_USER=platform@example.com
# bcrypt hash — NOT the plaintext password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 10))"
PLATFORM_ADMIN_PASS_HASH=$2a$10$replace_with_a_real_bcrypt_hash
# Separate secret for platform-admin session cookies (min 32 chars).
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PLATFORM_JWT_SECRET=your_platform_jwt_secret_here

# Legacy single-key lock for older /platform builds. Unused when the three
# variables above are set; kept so older deployments don't break.
# PLATFORM_ADMIN_KEY=your_platform_admin_key_here

# Impersonation — disabled by default in production for security.
# Set to "true" ONLY when you need to debug a school's account.
# Rotate back to unset (or "false") immediately after.
# ALLOW_IMPERSONATION=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=development

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Any SMTP provider works. Defaults to Gmail's host/port when unset.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
#
# SMTP_USER: the address that sends all system emails
# SMTP_PASS: Gmail App Password — NOT your Gmail login password.
#   Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
#   Google displays it as "xxxx xxxx xxxx xxxx" (16 chars, 4 groups).
#   You can paste it exactly as shown — spaces are stripped automatically.
#   NEVER use your real Gmail password here.
SMTP_USER=yourapp@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# PLATFORM_EMAIL: address that receives new-school and approval alerts.
# Can be the same as SMTP_USER.
PLATFORM_EMAIL=yourapp@gmail.com

# ── Cloudflare Turnstile (marketing-site contact form captcha) ───────────────
# Create a widget at https://dash.cloudflare.com → Turnstile → Add site.
# Use "Managed" mode. Domain: msingi.io (add localhost too for local testing).
# TURNSTILE_SECRET_KEY is server-only — never expose it to the client.
# VITE_TURNSTILE_SITE_KEY is public by design (Cloudflare's own model) and
# must be set at BUILD time for the client (client/.env, or the host's
# build-time env vars) — set on the server too only as a shared reference.
# Leaving either unset disables the captcha entirely (contact form still
# works, just unprotected) rather than breaking the form — see public.js.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ── Demo tenants (self-serve /demo) ──────────────────────────────────────────
# Each approved request gets its own school, cloned from the template tenant.
# The template must already exist in the target database — in production the
# demo seeder is skipped, so create/seed one once and point this at it.
DEMO_TEMPLATE_SCHOOL_ID=sch_demo
# How long a demo stays active. Data is frozen (not deleted) after expiry.
DEMO_TRIAL_DAYS=7
# Self-serve/platform extension size and cap.
DEMO_EXTENSION_DAYS=7
DEMO_MAX_EXTENSIONS=2
# Days after expiry before the tenant and its data are purged.
DEMO_PURGE_AFTER_DAYS=30
# Set "true" to send every request to the platform review queue instead of
# provisioning automatically after OTP verification.
# DEMO_REQUIRE_REVIEW=false
# Hourly lifecycle sweep (notices, expiry, purge).
# DEMO_SWEEP_CRON=17 * * * *

# ── Subscription expiry ──────────────────────────────────────────────────────
# Enforcement is opt-in. Effective expiry = planExpiresAt || trialEnds.
# When enabled, a school past expiry + grace keeps all staff/ERP features but
# loses student and parent portal access until it renews. The billed plan is
# never changed by expiry — that stays a platform-console decision.
# ENFORCE_PLAN_EXPIRY=true
PLAN_GRACE_DAYS=7
# Daily reminder sweep (30/14/7/1/0 days left, then one expiry notice).
# PLAN_REMINDER_CRON=0 5 * * *

# ── App URL ───────────────────────────────────────────────────────────────────
# Production: your exact Render service URL (no trailing slash)
# Development: http://localhost:3005
APP_URL=http://localhost:3005

# ── Nightly Backup ────────────────────────────────────────────────────────────
# AES-256-GCM encryption key for backup files (REQUIRED for KDPA Section 41).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set this on Render under Environment → Add Environment Variable.
BACKUP_ENCRYPTION_KEY=

# Cloud storage (S3-compatible) — REQUIRED for production (Render filesystem is
# ephemeral and is wiped on every deploy).
#
# AWS S3:
BACKUP_S3_BUCKET=msingi-backups
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# Cloudflare R2 (alternative — no egress fees):
#   BACKUP_S3_BUCKET=msingi-backups
#   BACKUP_S3_REGION=auto
#   BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   BACKUP_S3_FORCE_PATH=true
#   AWS_ACCESS_KEY_ID=<R2 API token ID>
#   AWS_SECRET_ACCESS_KEY=<R2 API token secret>
#
# Backblaze B2 (alternative):
#   BACKUP_S3_BUCKET=msingi-backups
#   BACKUP_S3_REGION=us-west-002
#   BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
#
# DigitalOcean Spaces (alternative):
#   BACKUP_S3_BUCKET=msingi-backups
#   BACKUP_S3_REGION=nyc3
#   BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
#
# Optional tuning:
# BACKUP_CRON_EXPR=0 23 * * *    # cron schedule (Africa/Nairobi). Default: 02:00 Kenya
# BACKUP_KEEP_DAYS=7             # daily files to retain per school. Default: 7
